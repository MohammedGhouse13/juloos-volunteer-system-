<%- include("head",{title}) %><div class="card"><h1>Volunteer Review</h1><img class="photo" src="/admin/file/<%=v.id%>/photo"><p>Name: <b><%=v.name%></b></p><p>Address: <%=v.address%></p><p>WhatsApp: <%=v.phone%></p><p>Emergency: <%=v.emergency_phone%></p><p>Age: <%=v.age%></p><p>Aadhaar: <%=v.aadhaar_masked%></p><p><a href="/admin/file/<%=v.id%>/aadhaar" target="_blank">View Aadhaar</a></p><h3>Status: <%=v.status%></h3><%if(v.status==="PENDING"){%><form method="post" action="/admin/volunteer/<%=v.id%>/approve"><button class="btn">APPROVE</button></form><form method="post" action="/admin/volunteer/<%=v.id%>/reject"><input name="reason" placeholder="Rejection reason" required><button class="btn red">REJECT</button></form><%}else if(v.status==="APPROVED"){%><p class="success">Volunteer ID: <b><%=v.volunteer_id%></b></p><a class="btn" href="/admin/id-card/<%=v.id%>">Generate ID Card</a><%}else{%><div class="error">Rejected: <%=v.rejection_reason%></div><%}%></div><%- include("foot") %>