<%- include('partials-head',{title,appName}) %>
<div class="page-head"><div><span class="pill">ADMIN REVIEW</span><h1><%= volunteer.full_name %></h1><p><%= volunteer.registration_number %></p></div></div>
<div class="card"><div class="grid two"><div><img class="review-photo" src="/admin/volunteer/<%= volunteer.id %>/photo" alt="Volunteer photo"><p><a href="/admin/volunteer/<%= volunteer.id %>/aadhaar" target="_blank">Open uploaded Aadhaar card</a></p><p><button class="btn outline" onclick="revealAadhaar()" type="button">Reveal Full Aadhaar</button></p><p id="aadhaarFull"></p></div><div><dl class="details"><dt>Registration</dt><dd><%= volunteer.registration_number %></dd><dt>Volunteer ID</dt><dd><%= volunteer.volunteer_id || 'Generated after approval' %></dd><dt>Full Name</dt><dd><%= volunteer.full_name %></dd><dt>Address / Place</dt><dd><%= volunteer.address %></dd><dt>WhatsApp</dt><dd><%= volunteer.whatsapp || volunteer.mobile %></dd><dt>Emergency</dt><dd><%= volunteer.emergency_mobile %></dd><dt>Age</dt><dd><%= volunteer.age %></dd><dt>Aadhaar</dt><dd><%= volunteer.masked_aadhaar %></dd><dt>Status</dt><dd><span class="badge <%= volunteer.approval_status.toLowerCase() %>"><%= volunteer.approval_status %></span></dd></dl></div></div>
<% if(volunteer.approval_status==='SUBMITTED'){ %><div class="decision-grid"><form method="post" action="/admin/volunteer/<%= volunteer.id %>/decision"><input type="hidden" name="decision" value="APPROVED"><button class="btn green large">✓ APPROVE</button></form><form method="post" action="/admin/volunteer/<%= volunteer.id %>/decision"><input type="hidden" name="decision" value="REJECTED"><input name="reason" placeholder="Rejection reason" required><button class="btn red">REJECT</button></form></div><% } %>
<% if(volunteer.approval_status==='APPROVED'){ %><div class="notice success"><strong>Approved.</strong> Volunteer ID: <b><%= volunteer.volunteer_id %></b></div><a class="btn gold" href="/admin/volunteer/<%= volunteer.id %>/id-card" target="_blank">Generate / Print ID Card</a><% } %>
<% if(volunteer.approval_status==='REJECTED'){ %><div class="alert danger"><strong>Rejected.</strong> <%= volunteer.rejection_reason %><br><small>The record and submitted files have not been deleted.</small></div><% } %>
</div>
<script>async function revealAadhaar(){const r=await fetch('/admin/volunteer/<%= volunteer.id %>/reveal-aadhaar');const d=await r.json();document.getElementById('aadhaarFull').textContent=r.ok?('Full Aadhaar: '+d.aadhaar):'Unable to reveal Aadhaar';}</script>
<%- include('partials-foot') %>
