<%- include('partials-head',{title,appName}) %><div class="page-head"><div><span class="pill"><%= volunteer.registration_number %></span><h1><%= volunteer.full_name %></h1><p><%= volunteer.volunteer_id %></p></div></div>
<div class="grid two"><div class="card profile"><img class="profile-photo" src="/admin/volunteer/<%= volunteer.id %>/photo" alt="Volunteer live photo"><div class="details"><p><b>Mobile:</b> <%= volunteer.mobile %> <a class="wa" target="_blank" href="https://wa.me/91<%= volunteer.whatsapp||volunteer.mobile %>">WhatsApp</a></p><p><b>Area:</b> <%= volunteer.area||'—' %></p><p><b>Role:</b> <%= volunteer.volunteer_role||'—' %></p><p><b>Gender/Age:</b> <%= volunteer.gender||'—' %> / <%= volunteer.age||'—' %></p><p><b>Masked Aadhaar:</b> <%= volunteer.masked_aadhaar %> <button class="smallbtn" onclick="revealAadhaar()">Reveal full number</button></p><p id="revealed" class="secret"></p></div></div>
<div class="card"><h2>Verification</h2><p>Aadhaar document match: <span class="badge approved"><%= volunteer.aadhaar_match_status %></span></p><p>OCR confidence: <%= volunteer.ocr_confidence||0 %>%</p><p>OCR name: <%= volunteer.ocr_name||'Not read' %></p><p>Name match score: <%= volunteer.name_match_score||0 %>%</p><a class="btn outline" target="_blank" href="/admin/volunteer/<%= volunteer.id %>/aadhaar">View Aadhaar Document</a><div class="actions"><form method="post" action="/admin/volunteer/<%= volunteer.id %>/decision"><input type="hidden" name="decision" value="APPROVED"><button class="btn gold">Approve</button></form><form method="post" action="/admin/volunteer/<%= volunteer.id %>/decision" onsubmit="return rejectIt(this)"><input type="hidden" name="decision" value="REJECTED"><input type="hidden" name="reason" id="rejectReason"><button class="btn dangerbtn">Reject</button></form></div></div></div>
<div class="card"><h2>Batch assignment</h2><form method="post" action="/admin/volunteer/<%= volunteer.id %>/batch" class="searchbar"><select name="batch_id"><option value="">No batch</option><% batches.forEach(b=>{ %><option value="<%= b.id %>" <%= volunteer.batch_id==b.id?'selected':'' %>><%= b.batch_code %> · <%= b.batch_name %></option><% }) %></select><button class="btn gold">Assign Batch</button></form><% if(volunteer.approval_status==='APPROVED'){ %><a class="btn outline" target="_blank" href="/admin/volunteer/<%= volunteer.id %>/id-card">Generate / Print ID Card</a><% } %></div>
<script>async function revealAadhaar(){const r=await fetch('/admin/volunteer/<%= volunteer.id %>/reveal-aadhaar');const j=await r.json();document.getElementById('revealed').textContent='Full Aadhaar: '+j.aadhaar;}function rejectIt(f){const r=prompt('Reason for rejection:');if(!r)return false;f.querySelector('#rejectReason').value=r;return true;}</script>
<%- include('partials-foot') %>