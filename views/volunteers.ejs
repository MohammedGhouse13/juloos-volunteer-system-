<%- include('partials-head',{title,appName}) %><div class="page-head"><div><span class="pill">DATABASE</span><h1>Volunteer Database</h1></div></div><div class="card"><form class="searchbar" method="get"><input name="search" value="<%= search %>" placeholder="Search name, mobile, registration or Volunteer ID"><select name="status"><option value="">All statuses</option><option value="SUBMITTED" <%= status==='SUBMITTED'?'selected':'' %>>Submitted</option><option value="APPROVED" <%= status==='APPROVED'?'selected':'' %>>Approved</option><option value="REJECTED" <%= status==='REJECTED'?'selected':'' %>>Rejected</option></select><button class="btn gold">Search</button></form><div class="tablewrap"><table><thead><tr><th>Serial</th><th>Name</th><th>Mobile</th><th>Aadhaar</th><th>Status</th><th>Batch</th><th>Action</th></tr></thead><tbody><% rows.forEach(v=>{ %><tr><td><%= v.registration_number %></td><td><%= v.full_name %></td><td><%= v.mobile %></td><td><%= v.masked_aadhaar %></td><td><span class="badge <%= v.approval_status.toLowerCase() %>"><%= v.approval_status %></span></td><td><%= v.batch_id||'—' %></td><td><a href="/admin/volunteer/<%= v.id %>">Open</a></td></tr><% }) %></tbody></table></div></div><%- include('partials-foot') %>