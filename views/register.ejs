<%- include('partials-head',{title,appName}) %>
<div class="page-head"><div><span class="pill">VOLUNTEER REGISTRATION</span><h1>Register for Markazi Milad Juloos</h1><p>Submit your details and wait for administrator approval. No automatic approval or Aadhaar matching is performed.</p></div></div>
<% if (error) { %><div class="alert danger"><%= error %></div><% } %>
<form class="card form" method="post" action="/register" enctype="multipart/form-data">
<h2>Volunteer Details</h2>
<div class="grid two">
<label>Full Name*<input name="full_name" required maxlength="120" autocomplete="name"></label>
<label>Age*<input name="age" type="number" min="12" max="80" required></label>
<label>WhatsApp Number*<input name="whatsapp" required inputmode="numeric" pattern="[6-9][0-9]{9}" maxlength="10" placeholder="10-digit number"></label>
<label>Emergency Contact Number*<input name="emergency_mobile" required inputmode="numeric" pattern="[6-9][0-9]{9}" maxlength="10" placeholder="10-digit number"></label>
<label class="full">Address / Place*<textarea name="address" rows="3" required></textarea></label>
</div>
<hr><h2>Aadhaar</h2>
<div class="privacy-box">Enter your Aadhaar number and upload a clear Aadhaar card image or PDF. The system does <strong>not</strong> perform OCR or automatic document matching. The document is retained for authorized administrator review.</div>
<label>Aadhaar Number*<input name="aadhaar" required inputmode="numeric" pattern="[2-9][0-9]{11}" maxlength="12" placeholder="12 digits" autocomplete="off"></label>
<label>Aadhaar Card*<input name="aadhaar_document" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" required></label>
<hr><h2>Profile Photo</h2>
<label>Upload Your Photo*<input name="photo" type="file" accept="image/jpeg,image/png,image/webp" required></label>
<p class="muted">Choose an existing photo from your phone/gallery or computer. Camera capture is not required.</p>
<div class="notice">Your application will first be reviewed by an administrator. If approved, a Volunteer ID and digital ID card will be generated. If rejected, your record and submitted files remain stored; only the status and rejection reason change.</div>
<label class="check"><input type="checkbox" name="consent" value="1" required> I confirm that the information is accurate and consent to its use for Juloos volunteer registration, coordination and ID-card issuance.</label>
<button class="btn gold large" type="submit">Submit Registration</button>
</form>
<%- include('partials-foot') %>
