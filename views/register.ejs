<%- include("head",{title}) %><div class="card"><h1>Volunteer Registration</h1><% if(error){%><div class="error"><%=error%></div><%}%><form method="post" enctype="multipart/form-data"><div class="grid"><label>Full Name*<input name="name" required></label><label>Age*<input name="age" type="number" required></label><label>WhatsApp Number*<input name="phone" required></label><label>Emergency Contact*<input name="emergency_phone" required></label><label class="wide">Address / Place*<textarea name="address" required></textarea></label><label>Aadhaar Number*<input name="aadhaar_number" maxlength="12" required></label><label>Profile Photo*<input name="photo" type="file" required><small>Choose a photo from your phone/gallery or computer. No camera.</small></label><label>Aadhaar Card*<input name="aadhaar_file" type="file" required></label></div><p><label><input type="checkbox" name="consent" value="yes" required> I agree to registration.</label></p><button class="btn">Submit Registration</button></form></div><%- include("foot") %>