<%- include('partials-head',{title,appName}) %><div class="narrow"><div class="card form"><span class="pill">STATUS</span><h1>Check Registration</h1><form method="post" action="/status"><label>Registration Number<input name="registration" required placeholder="JUL-000001"></label><label>WhatsApp Number<input name="whatsapp" required inputmode="numeric" maxlength="10"></label><button class="btn gold">Check Status</button></form></div><% if(error){ %><div class="alert danger"><%= error %></div><% } %><% if(result){ %><div class="card"><h2><%= result.full_name %></h2><p><strong><%= result.registration_number %></strong> · <%= result.volunteer_id||'Volunteer ID pending' %></p><span class="badge <%= result.approval_status.toLowerCase() %>"><%= result.approval_status %></span><% if(result.approval_status==='SUBMITTED'){ %><div class="notice">Your application has been received and is waiting for administrator approval.</div><% } %><% if(result.approval_status==='REJECTED'){ %><div class="alert danger"><strong>Registration Rejected</strong><p>Reason: <%= result.rejection_reason || 'Not approved' %></p><p>Your registration and uploaded files remain stored. No ID card has been issued.</p></div><% } %><% if(result.approval_status==='APPROVED'){ %><div class="notice success"><strong>Registration Approved.</strong><br>Your Volunteer ID is <b><%= result.volunteer_id %></b>.</div><a class="btn gold" target="_blank" href="/volunteer/<%= result.volunteer_id %>/id-card">Open / Print ID Card</a><% } %></div><% } %></div><%- include('partials-foot') %>
