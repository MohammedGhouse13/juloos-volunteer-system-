<%- include('partials-head',{title,appName}) %><div class="narrow"><div class="card form"><span class="pill">STATUS</span><h1>Check Registration</h1><form method="post" action="/status"><label>Registration number or Volunteer ID<input name="registration" required placeholder="JUL-000001 or SDI-JUL-26-000001"></label><button class="btn gold">Check</button></form></div>
<% if(error){ %><div class="alert danger"><%= error %></div><% } %>
<% if(result){ %><div class="card"><h2><%= result.full_name %></h2><p><strong><%= result.registration_number %></strong> · <%= result.volunteer_id||'Pending ID' %></p><span class="badge <%= result.approval_status.toLowerCase() %>"><%= result.approval_status %></span><dl><dt>Batch</dt><dd><%= result.batch?.batch_code||'Not assigned yet' %></dd><dt>ID card</dt><dd><%= result.id_card_status %></dd><dt>Registered</dt><dd><%= new Date(result.created_at).toLocaleString() %></dd></dl></div><% } %></div><%- include('partials-foot') %>