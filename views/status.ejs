<%- include("head",{title}) %><div class="card"><h1>Check Status</h1><%if(error){%><div class="error"><%=error%></div><%}%><%if(result){%><div class="success"><h2><%=result.status%></h2><p><%=result.name%> · <%=result.registration_no%></p><%if(result.volunteer_id){%><p>Volunteer ID: <b><%=result.volunteer_id%></b></p><a class="btn" href="/admin/id-card/<%=result.id%>">ID Card</a><%}%><%if(result.rejection_reason){%><p>Reason: <%=result.rejection_reason%></p><%}%></div><%}%><form method="post"><input name="registration_no" placeholder="Registration Number" required><input name="phone" placeholder="WhatsApp Number" required><button class="btn">Check</button></form></div><%- include("foot") %>