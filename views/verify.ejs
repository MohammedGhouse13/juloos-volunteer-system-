<%- include('partials-head',{title,appName}) %><div class="narrow"><div class="card center"><% if(valid){ %><div class="valid">✓</div><h1>VALID VOLUNTEER</h1><h2><%= v.full_name %></h2><p><strong><%= v.volunteer_id %></strong></p><span class="badge approved">APPROVED</span><p>Batch: <%= v.batch_code||'Not assigned' %> · <%= v.batch_name||'—' %></p><p>Role: <%= v.volunteer_role||'General Volunteer' %></p><% } else { %><div class="valid invalid">×</div><h1>INVALID / UNAUTHORIZED</h1><p>This Volunteer ID is not currently approved.</p><% } %></div></div><%- include('partials-foot') %>