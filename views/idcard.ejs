<!doctype html><html><head><meta charset="utf-8"><title><%= v.volunteer_id %> ID Card</title><link rel="stylesheet" href="/style.css"></head><body class="idpage"><div class="idcard"><div class="idtop"><span>☾</span><b>SUNNI DAWATE ISLAMI · HYDERABAD</b></div><div class="idtitle">MARKAZI MILAD JULOOS</div><div class="idbody"><img src="/admin/volunteer/<%= v.id %>/photo" alt=""><div><h1>VOLUNTEER</h1><h2><%= v.full_name %></h2><p><b>ID:</b> <%= v.volunteer_id %></p><p><b>BATCH:</b> <%= v.batch_code||'—' %> · <%= v.batch_name||'—' %></p><p><b>ROLE:</b> <%= v.volunteer_role||'General Volunteer' %></p><p><b>REPORT:</b> <%= v.reporting_time||'As instructed' %></p></div></div><div class="idfoot">Scan QR to verify this volunteer · Aadhaar is never encoded in the QR</div><div class="qr"><img alt="QR" src="<%= qrDataUrl %>"></div></div><button class="btn gold print" onclick="window.print()">Print ID Card</button></body></html>