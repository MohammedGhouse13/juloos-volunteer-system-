<%- include('partials-head',{title,appName}) %><div class="page-head"><div><span class="pill">ADMIN DASHBOARD</span><h1>Volunteer Operations</h1><p>Signed in as <%= admin.email %></p></div></div>
<div class="stats"><div><b><%= counts.total %></b><span>Total</span></div><div><b><%= counts.submitted %></b><span>Pending approval</span></div><div><b><%= counts.approved %></b><span>Approved</span></div><div><b><%= counts.rejected %></b><span>Rejected</span></div><div><b><%= counts.matched %></b><span>Aadhaar matched</span></div></div>
<div class="grid two"><div class="card"><h2>Create Batch</h2><form method="post" action="/admin/batches" class="form"><div class="grid two"><label>Batch code<input name="batch_code" placeholder="A" required></label><label>Batch name<input name="batch_name" placeholder="Charminar Team" required></label><label>Leader<input name="leader_name"></label><label>Leader mobile<input name="leader_mobile"></label><label>Capacity<input name="capacity" type="number" min="1" value="100"></label><label>Reporting time<input name="reporting_time" placeholder="4:30 AM"></label><label>Area<input name="route_area"></label><label>Meeting point<input name="meeting_point"></label></div><button class="btn gold">Create Batch</button></form></div>
<div class="card"><h2>Batches</h2><% batches.forEach(b=>{ %><div class="row"><div><strong><%= b.batch_code %> · <%= b.batch_name %></strong><small><%= b.volunteer_count %>/<%= b.capacity %> volunteers · <%= b.route_area||'Area not set' %></small></div><span class="badge"><%= b.status %></span></div><% }) %><a class="btn outline" href="/admin/volunteers">Open Volunteer Database</a></div></div>
<div class="card"><div class="table-head"><h2>Latest Registrations</h2><a class="btn outline" href="/admin/volunteers">View all</a></div><div class="tablewrap"><table><thead><tr><th>Serial</th><th>Name</th><th>Mobile</th><th>Aadhaar</th><th>Status</th><th></th></tr></thead><tbody><% pending.forEach(v=>{ %><tr><td><%= v.registration_number %></td><td><%= v.full_name %></td><td><%= v.mobile %></td><td><%= v.masked_aadhaar %></td><td><span class="badge <%= v.approval_status.toLowerCase() %>"><%= v.approval_status %></span></td><td><a href="/admin/volunteer/<%= v.id %>">Open</a></td></tr><% }) %></tbody></table></div></div>
<%- include('partials-foot') %>